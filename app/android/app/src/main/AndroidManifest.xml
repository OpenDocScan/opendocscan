<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The scanner needs the camera. It is deliberately not `required`, so
         the app still installs on a device without one and the import path
         works there. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The account needs a socket, so this build has one. It was deliberately
         absent until accounts existed, and dropping that guarantee without
         replacing it would have been the wrong trade: what replaces it is
         `isAccountHost` in lib/account/openapps.dart, which every request in
         the app passes through and which refuses any host but the account
         server. That is enforcement in software rather than by the OS — weaker,
         and honestly weaker, which is why README.md now says so in the same
         words instead of repeating the old claim.

         Nothing on the scanning path opens a connection: detection,
         rectification, filtering, recognition and PDF assembly are Rust running
         on this device, and `flutter test integration_test/` asserts a complete
         scan makes no request at all. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="OpenDocScan"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Where a finished sign-in comes back to. A native app has no page
                 for an OAuth redirect to land on, so the round trip ends at the
                 operating system: the browser is sent to
                 `opendocscan://auth#code=...` and Android hands this activity
                 the whole URI, fragment included.

                 `singleTop` above is load-bearing. Without it the callback
                 starts a second copy of the app rather than delivering to the
                 running one, and the scanner's state is lost on every sign-in.

                 Not `autoVerify`: verifying is for https App Links, and this is
                 a custom scheme. See README.md for what that costs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="opendocscan" android:host="auth"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11 and later hide every other installed package unless it is
             declared here. Without this the app cannot see that a browser
             exists, `launchUrl` returns false, and sign-in fails with "Could
             not open a browser" on a phone that plainly has one. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
